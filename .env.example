# Copie para .env (nunca versione o .env). Valores abaixo funcionam com o docker-compose.yml de dev.

# --- API ---
# NODE_ENV não fica aqui: o padrão é development e as plataformas definem production
# (no .env ele vazaria para o build do Vite e geraria o React de desenvolvimento).
PORT=3333
LOG_LEVEL=info
# Segredo dos access tokens (mín. 32 caracteres). Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=troque-este-segredo-de-desenvolvimento-por-um-aleatorio
# Origens extras liberadas no CORS/Socket.IO, separadas por vírgula (vazio = só mesma origem)
CORS_ORIGINS=http://localhost:5173
# Atrás de proxy (Render, Caddy) deixe true para o rate limit enxergar o IP real
TRUST_PROXY=false

# --- Banco ---
# Local/VPS: as duas URLs apontam para o mesmo Postgres.
# Supabase: as duas usam o "Session pooler" (porta 5432). Ver docs/deploy-gratuito.md.
DATABASE_URL=postgresql://tinpet:tinpet@localhost:5432/tinpet
DIRECT_URL=postgresql://tinpet:tinpet@localhost:5432/tinpet
# Banco usado pelos testes de integração (é apagado a cada execução)
TEST_DATABASE_URL=postgresql://tinpet:tinpet@localhost:5432/tinpet_test

# --- Storage: local | supabase | s3 ---
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=../../.data/uploads

# Supabase Storage (bucket público)
SUPABASE_URL=
# Secret key (sb_secret_...) — só no servidor
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=tinpet

# S3 compatível (RustFS/MinIO na VPS, AWS, R2...)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=tinpet
S3_ACCESS_KEY_ID=tinpet
S3_SECRET_ACCESS_KEY=tinpet-storage
# URL pública base dos arquivos (ex.: https://arquivos.seudominio.com/tinpet)
S3_PUBLIC_URL=http://localhost:9000/tinpet

# --- Web (Vite) ---
# Para onde o dev server do Vite encaminha /api
VITE_API_PROXY_TARGET=http://localhost:3333
# URL do Socket.IO quando a API está em outro domínio (vazio = mesma origem)
VITE_SOCKET_URL=
