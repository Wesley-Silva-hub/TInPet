# Reverse proxy com HTTPS automático (Let's Encrypt). Domínios vêm do .env.prod.

# App: front estático + API (/api, inclusive WebSocket do Socket.IO) na mesma origem
{$APP_DOMAIN} {
	encode zstd gzip

	handle /api/* {
		reverse_proxy api:3333
	}

	handle {
		root * /srv/web
		try_files {path} /index.html
		header /assets/* Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
}

# Arquivos públicos (fotos), servidos pelo storage S3
{$FILES_DOMAIN} {
	encode zstd gzip
	reverse_proxy s3:9000
}
