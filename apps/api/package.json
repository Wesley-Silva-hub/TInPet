{
  "name": "@tinpet/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "prisma/schema.prisma",
    "prisma/migrations",
    "prisma.config.ts"
  ],
  "scripts": {
    "dev": "node --watch --import tsx --env-file-if-exists=../../.env src/server.ts",
    "build": "prisma generate && tsdown",
    "start": "node dist/server.mjs",
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1161.0",
    "@fastify/cookie": "11.1.5",
    "@fastify/cors": "11.4.0",
    "@fastify/helmet": "13.2.0",
    "@fastify/multipart": "10.1.7",
    "@fastify/rate-limit": "11.2.2",
    "@fastify/swagger": "9.9.3",
    "@fastify/swagger-ui": "6.1.3",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@tinpet/shared": "workspace:*",
    "argon2": "0.45.2",
    "fastify": "5.12.8",
    "fastify-type-provider-zod": "7.0.0",
    "jose": "6.2.15",
    "prisma": "7.10.1",
    "sharp": "0.35.5",
    "socket.io": "4.8.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "pino-pretty": "13.2.0",
    "socket.io-client": "4.8.4",
    "tsdown": "0.23.1",
    "tsx": "4.23.15",
    "vitest": "5.0.5"
  }
}
