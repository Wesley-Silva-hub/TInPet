// Convenções: models em PascalCase, tabelas/colunas em snake_case, IDs uuid.
// Arquivos (fotos, avatar, imagens) guardam só a chave do storage; a URL é montada
// pelo StorageProvider, o que permite trocar Supabase por S3/VPS sem migrar dados.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  COMPANY
  ADMIN
}

enum Species {
  DOG
  CAT
  BIRD
  RABBIT
  RODENT
  OTHER
}

enum PetSex {
  MALE
  FEMALE
}

enum PetSize {
  SMALL
  MEDIUM
  LARGE
}

enum PetPurpose {
  MATING
  FRIENDSHIP
  BOTH
}

enum SwipeDirection {
  LIKE
  PASS
}

enum ProductCategory {
  FOOD
  ACCESSORIES
  TOYS
  HYGIENE
  HEALTH
  SERVICES
  OTHER
}

enum ArticleCategory {
  HEALTH
  BEHAVIOR
  ADOPTION
  NUTRITION
  CURIOSITIES
  EVENTS
}

enum CompanyKind {
  PETSHOP
  VET_CLINIC
  GROOMING
  STORE
  OTHER
}

enum NotificationType {
  POST_LIKE
  POST_COMMENT
  MATCH
}

enum ReportReason {
  SPAM
  OFFENSIVE
  FAKE_PROFILE
  ANIMAL_ABUSE
  OTHER
}

model User {
  id                String    @id @default(uuid()) @db.Uuid
  email             String    @unique @db.VarChar(254)
  passwordHash      String    @map("password_hash")
  name              String    @db.VarChar(80)
  birthDate         DateTime  @map("birth_date") @db.Date
  bio               String    @default("") @db.VarChar(500)
  role              Role      @default(OWNER)
  maritalStatusId   Int?      @map("marital_status_id")
  professionId      Int?      @map("profession_id")
  avatarKey         String?   @map("avatar_key")
  /// Coordenadas arredondadas (~1 km). Nunca devolvidas para outros usuários.
  latitude          Float?
  longitude         Float?
  city              String?   @db.VarChar(80)
  state             String?   @db.Char(2)
  consentTermsAt    DateTime  @map("consent_terms_at")
  consentLocationAt DateTime? @map("consent_location_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  maritalStatus     MaritalStatus?        @relation(fields: [maritalStatusId], references: [id], onDelete: SetNull)
  profession        Profession?           @relation(fields: [professionId], references: [id], onDelete: SetNull)
  company           CompanyProfile?
  pets              Pet[]
  products          Product[]
  messages          Message[]
  refreshTokens     RefreshToken[]
  blocksMade        Block[]               @relation("Blocker")
  blocksReceived    Block[]               @relation("Blocked")
  reportsMade       Report[]              @relation("Reporter")
  reportsAgainst    Report[]              @relation("Reported")
  posts             Post[]
  postLikes         PostLike[]
  postComments      PostComment[]
  notifications     Notification[]        @relation("NotificationRecipient")
  notificationsSent Notification[]        @relation("NotificationActor")
  promotions        Promotion[]
  promotionViews    PromotionImpression[]

  @@index([maritalStatusId])
  @@index([professionId])
  @@index([latitude, longitude])
  @@map("users")
}

model MaritalStatus {
  id    Int    @id @default(autoincrement())
  name  String @unique @db.VarChar(50)
  users User[]

  @@map("marital_statuses")
}

model Profession {
  id    Int    @id @default(autoincrement())
  name  String @unique @db.VarChar(80)
  users User[]

  @@map("professions")
}

/// Dados da empresa anunciante (usuário com papel COMPANY).
model CompanyProfile {
  userId       String      @id @map("user_id") @db.Uuid
  tradeName    String      @map("trade_name") @db.VarChar(120)
  cnpj         String      @unique @db.Char(14)
  phone        String?     @db.VarChar(20)
  website      String?     @db.VarChar(300)
  kind         CompanyKind @default(PETSHOP)
  description  String      @default("") @db.VarChar(500)
  neighborhood String      @default("") @db.VarChar(80)
  /// Endereço comercial público (opcional)
  address      String      @default("") @db.VarChar(200)
  delivers     Boolean     @default(false)
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("company_profiles")
}

model Breed {
  id      Int     @id @default(autoincrement())
  species Species
  name    String  @db.VarChar(80)
  pets    Pet[]

  @@unique([species, name])
  @@map("breeds")
}

model Pet {
  id        String     @id @default(uuid()) @db.Uuid
  ownerId   String     @map("owner_id") @db.Uuid
  name      String     @db.VarChar(50)
  species   Species
  breedId   Int?       @map("breed_id")
  sex       PetSex
  size      PetSize
  birthDate DateTime?  @map("birth_date") @db.Date
  bio       String     @default("") @db.VarChar(500)
  purpose   PetPurpose
  isActive  Boolean    @default(true) @map("is_active")
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  owner          User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  breed          Breed?       @relation(fields: [breedId], references: [id], onDelete: SetNull)
  photos         PetPhoto[]
  swipesMade     Swipe[]      @relation("SwipeFrom")
  swipesReceived Swipe[]      @relation("SwipeTo")
  matchesAsA     Match[]      @relation("MatchPetA")
  matchesAsB     Match[]      @relation("MatchPetB")
  posts          Post[]
  vaccines       PetVaccine[]

  @@index([ownerId])
  @@index([breedId])
  @@index([species, isActive])
  @@map("pets")
}

model PetPhoto {
  id         String   @id @default(uuid()) @db.Uuid
  petId      String   @map("pet_id") @db.Uuid
  storageKey String   @map("storage_key")
  position   Int
  createdAt  DateTime @default(now()) @map("created_at")
  pet        Pet      @relation(fields: [petId], references: [id], onDelete: Cascade)

  @@index([petId, position])
  @@map("pet_photos")
}

model Swipe {
  fromPetId String         @map("from_pet_id") @db.Uuid
  toPetId   String         @map("to_pet_id") @db.Uuid
  direction SwipeDirection
  createdAt DateTime       @default(now()) @map("created_at")
  fromPet   Pet            @relation("SwipeFrom", fields: [fromPetId], references: [id], onDelete: Cascade)
  toPet     Pet            @relation("SwipeTo", fields: [toPetId], references: [id], onDelete: Cascade)

  @@id([fromPetId, toPetId])
  @@index([toPetId])
  @@map("swipes")
}

/// pet_a_id < pet_b_id (garantido pela aplicação e por CHECK na migration), um match por par.
model Match {
  id            String         @id @default(uuid()) @db.Uuid
  petAId        String         @map("pet_a_id") @db.Uuid
  petBId        String         @map("pet_b_id") @db.Uuid
  createdAt     DateTime       @default(now()) @map("created_at")
  unmatchedAt   DateTime?      @map("unmatched_at")
  petA          Pet            @relation("MatchPetA", fields: [petAId], references: [id], onDelete: Cascade)
  petB          Pet            @relation("MatchPetB", fields: [petBId], references: [id], onDelete: Cascade)
  messages      Message[]
  notifications Notification[]

  @@unique([petAId, petBId])
  @@index([petBId])
  @@map("matches")
}

model Message {
  id        String    @id @default(uuid()) @db.Uuid
  matchId   String    @map("match_id") @db.Uuid
  senderId  String    @map("sender_id") @db.Uuid
  content   String    @db.VarChar(2000)
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")
  match     Match     @relation(fields: [matchId], references: [id], onDelete: Cascade)
  sender    User      @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([matchId, createdAt])
  @@index([senderId])
  @@map("messages")
}

model Product {
  id           String          @id @default(uuid()) @db.Uuid
  companyId    String          @map("company_id") @db.Uuid
  title        String          @db.VarChar(120)
  description  String          @default("") @db.VarChar(2000)
  /// Sempre em centavos.
  priceCents   Int             @map("price_cents")
  category     ProductCategory
  imageKey     String?         @map("image_key")
  externalLink String?         @map("external_link") @db.VarChar(500)
  isActive     Boolean         @default(true) @map("is_active")
  /// Espécies para as quais o produto serve (vazio = todas)
  species      Species[]       @default([])
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")
  company      User            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  promotions   Promotion[]

  @@index([companyId])
  @@index([category, isActive, createdAt])
  @@map("products")
}

/// Refresh tokens rotativos. Só o hash é guardado; reuso de token revogado revoga a família inteira.
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  familyId  String    @map("family_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

model Block {
  blockerId String   @map("blocker_id") @db.Uuid
  blockedId String   @map("blocked_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  blocker   User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  @@index([blockedId])
  @@map("blocks")
}

/// Denúncias ficam para moderação mesmo se o denunciante excluir a conta.
model Report {
  id         String       @id @default(uuid()) @db.Uuid
  reporterId String?      @map("reporter_id") @db.Uuid
  reportedId String       @map("reported_id") @db.Uuid
  reason     ReportReason
  details    String       @default("") @db.VarChar(1000)
  createdAt  DateTime     @default(now()) @map("created_at")
  resolvedAt DateTime?    @map("resolved_at")
  reporter   User?        @relation("Reporter", fields: [reporterId], references: [id], onDelete: SetNull)
  reported   User         @relation("Reported", fields: [reportedId], references: [id], onDelete: Cascade)

  @@index([reporterId])
  @@index([reportedId])
  @@map("reports")
}

/// Publicação no feed social (a "Postagem" do MER original).
model Post {
  id            String         @id @default(uuid()) @db.Uuid
  authorId      String         @map("author_id") @db.Uuid
  petId         String?        @map("pet_id") @db.Uuid
  imageKey      String         @map("image_key")
  caption       String         @default("") @db.VarChar(2200)
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  author        User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  pet           Pet?           @relation(fields: [petId], references: [id], onDelete: SetNull)
  likes         PostLike[]
  comments      PostComment[]
  notifications Notification[]

  @@index([createdAt, id])
  @@index([authorId, createdAt])
  @@index([petId])
  @@map("posts")
}

model PostLike {
  postId    String   @map("post_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([postId, userId])
  @@index([userId])
  @@map("post_likes")
}

model PostComment {
  id        String   @id @default(uuid()) @db.Uuid
  postId    String   @map("post_id") @db.Uuid
  authorId  String   @map("author_id") @db.Uuid
  content   String   @db.VarChar(500)
  createdAt DateTime @default(now()) @map("created_at")
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
  @@index([authorId])
  @@map("post_comments")
}

/// Notícias e dicas sobre pets (conteúdo editorial próprio).
model Article {
  id          String          @id @default(uuid()) @db.Uuid
  slug        String          @unique @db.VarChar(120)
  title       String          @db.VarChar(160)
  summary     String          @db.VarChar(400)
  body        String
  category    ArticleCategory
  coverKey    String?         @map("cover_key")
  readMinutes Int             @default(3) @map("read_minutes")
  publishedAt DateTime        @default(now()) @map("published_at")
  createdAt   DateTime        @default(now()) @map("created_at")

  @@index([category, publishedAt])
  @@index([publishedAt])
  @@map("articles")
}

/// Carteira de vacinação. Dados de saúde: só o tutor vê; o público vê apenas "vacinas em dia".
model PetVaccine {
  id        String    @id @default(uuid()) @db.Uuid
  petId     String    @map("pet_id") @db.Uuid
  name      String    @db.VarChar(80)
  appliedAt DateTime  @map("applied_at") @db.Date
  nextDueAt DateTime? @map("next_due_at") @db.Date
  clinic    String    @default("") @db.VarChar(120)
  notes     String    @default("") @db.VarChar(500)
  createdAt DateTime  @default(now()) @map("created_at")
  pet       Pet       @relation(fields: [petId], references: [id], onDelete: Cascade)

  @@index([petId, appliedAt])
  @@index([nextDueAt])
  @@map("pet_vaccines")
}

/// Avisos dentro do app (curtidas, comentários e matches).
model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  actorId   String?          @map("actor_id") @db.Uuid
  type      NotificationType
  postId    String?          @map("post_id") @db.Uuid
  matchId   String?          @map("match_id") @db.Uuid
  /// Trecho do comentário, quando houver
  preview   String           @default("") @db.VarChar(140)
  readAt    DateTime?        @map("read_at")
  createdAt DateTime         @default(now()) @map("created_at")
  user      User             @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  actor     User?            @relation("NotificationActor", fields: [actorId], references: [id], onDelete: Cascade)
  post      Post?            @relation(fields: [postId], references: [id], onDelete: Cascade)
  match     Match?           @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@index([actorId])
  @@index([postId])
  @@index([matchId])
  @@map("notifications")
}

/// Anúncio impulsionado por uma loja: oferta relâmpago/cupom mostrada a quem tem o pet certo e mora perto.
model Promotion {
  id              String                @id @default(uuid()) @db.Uuid
  companyId       String                @map("company_id") @db.Uuid
  productId       String                @map("product_id") @db.Uuid
  headline        String                @db.VarChar(80)
  discountPercent Int?                  @map("discount_percent")
  couponCode      String?               @map("coupon_code") @db.VarChar(30)
  /// Espécies do público (vazio = todas)
  species         Species[]             @default([])
  radiusKm        Int                   @default(10) @map("radius_km")
  startsAt        DateTime              @default(now()) @map("starts_at")
  endsAt          DateTime              @map("ends_at")
  pausedAt        DateTime?             @map("paused_at")
  clicks          Int                   @default(0)
  couponReveals   Int                   @default(0) @map("coupon_reveals")
  createdAt       DateTime              @default(now()) @map("created_at")
  company         User                  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  product         Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  impressions     PromotionImpression[]

  @@index([companyId])
  @@index([endsAt, startsAt])
  @@index([productId])
  @@map("promotions")
}

/// Visualização única por pessoa por dia (métrica honesta para a loja).
model PromotionImpression {
  promotionId String    @map("promotion_id") @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  day         DateTime  @db.Date
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([promotionId, userId, day])
  @@index([userId])
  @@map("promotion_impressions")
}
